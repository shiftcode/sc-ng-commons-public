{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "lib": ["es2022", "es2023.array", "dom", "esnext.disposable"],
    "types": ["node"]
  },
  "include": ["**/*.spec.ts", "**/*.d.ts", "test/**/*.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
